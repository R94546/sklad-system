{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd sklad-web && npm install && npm run build",
  "outputDirectory": "sklad-web/dist",
  "installCommand": "npm install --prefix sklad-web",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
